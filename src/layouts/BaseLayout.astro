---
import "../styles/global.css";

const { title = "AJ Shearer for Monaghan Ward Councillor" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>{title}</title>

  <meta
    name="description"
    content="AJ Shearer is running for City Councillor in Monaghan Ward, Peterborough. Focused on affordability, accountability, responsible growth, and a stronger future for local families."
  />

  <link rel="canonical" href="https://vote.ajshearer.com/" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://vote.ajshearer.com/" />
  <meta property="og:title" content="AJ Shearer for Monaghan Ward Councillor" />
  <meta
    property="og:description"
    content="A practical voice for Monaghan Ward. Focused on affordability, accountability, responsible growth, and a stronger future for Peterborough families."
  />
  <meta
    property="og:image"
    content="https://vote.ajshearer.com/images/og-image.jpg"
  />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="AJ Shearer for Monaghan Ward Councillor" />
  <meta
    name="twitter:description"
    content="A practical voice for Monaghan Ward. Focused on affordability, accountability, responsible growth, and a stronger future for Peterborough families."
  />
  <meta
    name="twitter:image"
    content="https://vote.ajshearer.com/images/og-image.jpg"
  />
</head>

  <body class="bg-white text-slate-900">
    <slot />
  </body>
</html>