---
import "../styles/global.css";

const { title = "AJ Shearer for Monaghan Ward Councillor" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta
      name="description"
      content="Affordable. Accessible. Prosperous."
    />
  </head>

  <body class="bg-white text-slate-900">
    <slot />
  </body>
</html>