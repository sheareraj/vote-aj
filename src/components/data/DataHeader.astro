---
const { compact = false } = Astro.props;
---
<header class="border-b border-[#efe4e7] bg-white/95 backdrop-blur">
  <div class={`mx-auto flex ${compact ? 'max-w-7xl' : 'max-w-6xl'} items-center justify-between gap-4 px-4 py-4 md:px-6`}>
    <a href="/data" class="min-w-0">
      <div class="text-lg font-black tracking-tight text-[#651024] md:text-xl">Peterborough By The Numbers</div>
      <div class="mt-0.5 text-[0.62rem] font-bold uppercase tracking-[0.2em] text-[#7a6167]">A five-minute guide to City Hall</div>
    </a>
    <nav class="flex shrink-0 items-center gap-1 text-sm font-semibold md:gap-2">
      <a href="/data/taxes" class="hidden rounded-full px-3 py-2 text-[#651024] hover:bg-[#f8f1f3] md:inline-flex">Taxes</a>
      <a href="/data/spending" class="hidden rounded-full px-3 py-2 text-[#651024] hover:bg-[#f8f1f3] lg:inline-flex">Spending</a>
      <a href="/data/results" class="hidden rounded-full px-3 py-2 text-[#651024] hover:bg-[#f8f1f3] lg:inline-flex">Results</a>
      <a href="/data/decisions" class="hidden rounded-full px-3 py-2 text-[#651024] hover:bg-[#f8f1f3] md:inline-flex">Decisions</a>
      <a href="/data#advanced-tools" class="hidden rounded-full border border-[#dcc7cd] px-3 py-2 text-[#651024] hover:bg-[#f8f1f3] sm:inline-flex">Full data</a>
      <a href="/" class="rounded-full bg-[#651024] px-3 py-2 text-white hover:bg-[#7a2337]">Campaign</a>
    </nav>
  </div>
  <div class="border-t border-[#f3eaed] bg-[#fffafb]">
    <div class={`mx-auto flex ${compact ? 'max-w-7xl' : 'max-w-6xl'} flex-wrap items-center justify-between gap-2 px-4 py-2 text-[11px] font-semibold text-[#7a6167] md:px-6`}>
      <span>Primary-source data · last validated Sept. 20, 2026</span>
      <a href="/data/methodology" class="font-bold text-[#651024] hover:underline">Methodology & corrections →</a>
    </div>
  </div>
</header>
