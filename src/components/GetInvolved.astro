---

---

<section id="involved" class="bg-gradient-to-br from-[#7a2337] to-[#651024] py-20 text-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-6 md:grid-cols-[1fr_0.95fr] md:items-start">
    <div>
      <div class="text-sm font-bold uppercase tracking-[0.25em] text-[#f3dfe5]">
        Get involved
      </div>

      <h2 class="mt-3 max-w-xl text-4xl font-bold tracking-tight md:text-5xl">
        Help build momentum across Monaghan Ward.
      </h2>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-[#f3dfe5]">
        Sign up for campaign updates, volunteer opportunities, lawn signs,
        and event information.
      </p>
    </div>

    <div class="rounded-3xl bg-white p-6 text-[#3a1a22] shadow-md">
      <div class="text-xl font-bold tracking-tight">
        Get in touch
      </div>

      <div class="mt-1 text-sm text-[#7a6167]">
        I'm more excited to hear from you than you are to fill out this form!
      </div>

      <form
        action="https://formspree.io/f/mzdojrpy"
        method="POST"
        class="mt-6 grid gap-4"
      >
        <input
          name="name"
          class="rounded-2xl border border-[#d9b8c2] px-4 py-3 outline-none focus:border-[#651024]"
          placeholder="Full name"
        />

        <input
          type="email"
          name="email"
          class="rounded-2xl border border-[#d9b8c2] px-4 py-3 outline-none focus:border-[#651024]"
          placeholder="Email address"
        />

        <input
          name="postalCode"
          class="rounded-2xl border border-[#d9b8c2] px-4 py-3 outline-none focus:border-[#651024]"
          placeholder="Postal code"
        />

        <label class="flex items-center gap-3 rounded-2xl border border-[#d9b8c2] px-4 py-3 text-[#3a1a22]">
          <input
            type="checkbox"
            name="lawnSign"
            class="h-5 w-5 accent-[#651024]"
          />

          <span class="font-medium">
            I want a lawn sign
          </span>
        </label>

        <textarea
          name="mutual_help"
          placeholder="How can we help each other?"
          rows="4"
          class="w-full rounded-xl border border-[#d9b8c2] px-4 py-3 text-[#3a1a22] placeholder-[#6b4a53] outline-none focus:border-[#651024] focus:ring-2 focus:ring-[#efe4e7]"
        ></textarea>

        <button
          type="submit"
          class="rounded-2xl bg-[#651024] px-5 py-3 font-semibold text-white transition hover:bg-[#7a2337]"
        >
          Sign Up
        </button>
      </form>
    </div>
  </div>
</section>