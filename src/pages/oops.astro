---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Sorry I Missed You | AJ Shearer">
  <div class="min-h-screen bg-[#f8f1f3] text-[#3a1a22]">
    <section class="bg-[#651024] px-6 py-16 text-white">
      <div class="mx-auto max-w-6xl">
        <a href="/" class="text-sm font-semibold text-[#f3dfe5] hover:underline">
          ← Back to Main Site
        </a>

        <div class="mt-8 max-w-4xl">
          <div class="text-sm font-bold uppercase tracking-[0.25em] text-[#f3dfe5]">
            Sorry I Missed You
          </div>

          <h1 class="mt-3 text-4xl font-bold tracking-tight text-[#fff7f9] md:text-5xl">
            I was hoping to introduce myself in person.
          </h1>

          <p class="mt-6 max-w-3xl text-lg leading-8 text-[#f3dfe5]">
            I'm AJ Shearer, and I'm running for City Councillor in Monaghan
            Ward. I wanted to leave you a quick message and an easy way to get
            in touch.
          </p>
        </div>
      </div>
    </section>

    <main class="mx-auto max-w-5xl px-6 py-20">
      <section class="rounded-3xl bg-white p-8 shadow-sm ring-1 ring-[#efe4e7] md:p-10">
        <div class="grid gap-10 md:grid-cols-[0.9fr_1.1fr] md:items-start">
          <div>
            <div class="text-sm font-bold uppercase tracking-[0.25em] text-[#651024]">
              Quick Message
            </div>

            <h2 class="mt-3 text-4xl font-bold tracking-tight text-[#3a1a22]">
              Sorry I missed you at the door!
            </h2>

            <p class="mt-5 text-lg leading-8 text-[#7a6167]">
              I was hoping to speak with you directly, but if now is a better
              time, please take a moment to watch this short message.
            </p>

            <div class="mt-8 overflow-hidden rounded-2xl bg-[#2b0b14] shadow-sm">
              <div class="mx-auto aspect-square max-w-md">
                <iframe
                  class="h-full w-full"
                  src="https://www.youtube.com/embed/9QfezQ3jfTs"
                  title="Sorry I missed you at the door"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
          </div>

          <div class="rounded-3xl bg-[#f8f1f3] p-6 ring-1 ring-[#efe4e7]">
            <h2 class="text-3xl font-bold tracking-tight text-[#3a1a22]">
              Get in touch
            </h2>

            <p class="mt-3 text-base leading-7 text-[#7a6167]">
              Have a question, concern, or idea for Monaghan Ward? Send me a
              message and I'll follow up.
            </p>

            <form
              action="https://formspree.io/f/xvzldnvz"
              method="POST"
              class="mt-6 grid gap-4"
            >
              <div class="grid gap-4 md:grid-cols-2">
                <input
                  name="firstName"
                  required
                  class="rounded-2xl border border-[#d9b8c2] bg-white px-4 py-3 outline-none focus:border-[#651024]"
                  placeholder="First name"
                />

                <input
                  name="lastName"
                  required
                  class="rounded-2xl border border-[#d9b8c2] bg-white px-4 py-3 outline-none focus:border-[#651024]"
                  placeholder="Last name"
                />
              </div>

              <input
                type="email"
                name="email"
                required
                class="rounded-2xl border border-[#d9b8c2] bg-white px-4 py-3 outline-none focus:border-[#651024]"
                placeholder="Email address"
              />

              <input
                name="postalCode"
                class="rounded-2xl border border-[#d9b8c2] bg-white px-4 py-3 outline-none focus:border-[#651024]"
                placeholder="Postal code"
              />

              <textarea
                name="message"
                rows="5"
                class="rounded-2xl border border-[#d9b8c2] bg-white px-4 py-3 outline-none focus:border-[#651024]"
                placeholder="What would you like to talk about?"
              ></textarea>

              <button
                type="submit"
                class="rounded-2xl bg-[#651024] px-5 py-3 font-semibold text-white transition hover:bg-[#7a2337]"
              >
                Send AJ a Message
              </button>
            </form>
          </div>
        </div>
      </section>

    </main>

    <footer class="bg-[#651024] py-16 text-white">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid gap-10 md:grid-cols-2 md:items-center">
          <div>
            <div class="text-sm font-bold uppercase tracking-[0.25em] text-[#f3dfe5]">
              AJ Shearer
            </div>

            <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">
              Let's build a stronger Peterborough together.
            </h2>

            <p class="mt-4 max-w-2xl text-lg leading-8 text-[#f3dfe5]">
              If you'd like to learn more, volunteer, request a lawn sign, or
              simply share your thoughts, I'd love to hear from you.
            </p>
          </div>

          <div class="flex flex-wrap gap-4 md:justify-end">
            <a
              href="/"
              class="rounded-full bg-white px-6 py-3 font-semibold text-[#651024] shadow-lg transition hover:-translate-y-0.5"
            >
              Main Website
            </a>

            <a
              href="https://www.facebook.com/profile.php?id=61589293620797"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full border border-white/40 px-6 py-3 font-semibold text-white transition hover:bg-white/10"
            >
              Facebook
            </a>
          </div>
        </div>

        <div class="mt-12 border-t border-white/15 pt-6 text-sm text-[#f3dfe5]">
          © {new Date().getFullYear()} AJ Shearer • Candidate for Councillor,
          Monaghan Ward • City of Peterborough
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>