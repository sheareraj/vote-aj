---
import "../styles/global.css";

const communityItems = [
  "Peterborough Pagans — Junior's coach & sponsor",
  "Peterborough Squash Club — Board member, volunteer & sponsor",
  "Buckhorn Snowmobile Club — Trail maintenance volunteer",
  "PGHA Ice Kats — Sponsor",
  "Peterborough Thunder — Sponsor",
  "Peterborough Horticultural Society — Donor",
  "Peterborough Dragon Boat Festival — Donor",
];
---

<html lang="en">
  <head>
    <title>Experience & Background | AJ Shearer</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="Learn more about AJ Shearer's education, professional background, consulting work, business ownership, real estate experience, leadership, and community involvement."
    />
  </head>

  <body>
    <div class="min-h-screen bg-[#f8f1f3] text-[#3a1a22]">
      <header class="bg-[#651024] px-6 py-10 text-white">
        <div class="mx-auto max-w-6xl">
          <a href="/" class="text-sm font-semibold text-[#f3dfe5] hover:underline">
            ← Back to main site
          </a>

          <div class="mt-10">
            <div class="text-sm font-bold uppercase tracking-[0.25em] text-[#f3dfe5]">
              AJ Shearer
            </div>

            <h1 class="mt-3 text-5xl font-bold tracking-tight md:text-6xl">
              Experience, skills, and community roots.
            </h1>

<p class="mt-6 max-w-2xl text-lg leading-8 text-[#f3dfe5]">
  A brief look at the background, work experience, leadership, and
  community involvement that have shaped how I approach complex
  problems, evaluate information, and focus on practical outcomes.
</p>
          </div>
        </div>
      </header>

      <main class="mx-auto max-w-6xl px-6 py-20">
        <section class="rounded-3xl bg-white p-8 shadow-sm ring-1 ring-[#efe4e7] md:p-10">
          <div class="text-sm font-bold uppercase tracking-[0.25em] text-[#651024]">
            Where I've Developed My Skills
          </div>

          <h2 class="mt-3 text-4xl font-bold tracking-tight text-[#3a1a22]">
            Education, experience, and a lifelong commitment to learning.
          </h2>

          <div class="mt-12 grid gap-10 md:grid-cols-3">
            <div>
              <h3 class="text-2xl font-bold text-[#3a1a22]">
                Peterborough Roots
              </h3>

              <p class="mt-3 text-base leading-7 text-[#7a6167]">
                Grew up primarily in Peterborough and attended RF Downey,
                Prince of Wales, and Adam Scott.
              </p>
            </div>

            <div>
              <h3 class="text-2xl font-bold text-[#3a1a22]">
                Engineering Education
              </h3>

              <p class="mt-3 text-base leading-7 text-[#7a6167]">
                Bachelor of Engineering with Distinction from Carleton
                University.
              </p>
            </div>

            <div>
              <h3 class="text-2xl font-bold text-[#3a1a22]">
                Lifelong Learning
              </h3>

              <p class="mt-3 text-base leading-7 text-[#7a6167]">
                Entrepreneurship and business ownership have reinforced the
                importance of adaptability, curiosity, and continuous learning.
              </p>
            </div>
          </div>
        </section>

        <section class="mt-10 rounded-3xl bg-white p-8 shadow-sm ring-1 ring-[#efe4e7] md:p-10">
          <div class="text-sm font-bold uppercase tracking-[0.25em] text-[#651024]">
            How I've Earned a Living
          </div>

          <h2 class="mt-3 text-4xl font-bold tracking-tight text-[#3a1a22]">
            Experience across technology, consulting, business ownership, and real estate.
          </h2>

          <div class="mt-12 grid gap-10 md:grid-cols-2">
            <div>
              <h3 class="text-2xl font-bold text-[#3a1a22]">
                Systems & Technology
              </h3>

              <p class="mt-3 text-base leading-7 text-[#7a6167]">
                Started in software testing and system integration, working on
                reliability, process improvement, requirements, and practical
                technology implementation.
              </p>
            </div>

<div>
  <h3 class="text-2xl font-bold text-[#3a1a22]">
    Consulting
  </h3>

  <p class="mt-3 text-base leading-7 text-[#7a6167]">
    Worked with organizations to understand complex systems, identify
    what was driving performance, define measurable outcomes, and make
    better decisions using the data and information available to them.
  </p>
</div>

            <div>
              <h3 class="text-2xl font-bold text-[#3a1a22]">
                Business Ownership
              </h3>

              <p class="mt-3 text-base leading-7 text-[#7a6167]">
                Co-founded and helped lead a business intelligence, analytics,
                change management, and system integration firm, managing client
                relationships, budgets, teams, and project delivery.
              </p>
            </div>

            <div>
              <h3 class="text-2xl font-bold text-[#3a1a22]">
                Healthcare & Public Sector
              </h3>

              <p class="mt-3 text-base leading-7 text-[#7a6167]">
                Completed projects for organizations including Hawkesbury
                General Hospital and Eastern Lynn, supporting reporting,
                billing, operational decision-making, and performance
                improvement.
              </p>
            </div>

            <div>
              <h3 class="text-2xl font-bold text-[#3a1a22]">
                Private Sector & B2C Work
              </h3>

              <p class="mt-3 text-base leading-7 text-[#7a6167]">
                Delivered work for private companies, including business-to-
                consumer organizations, where practical data, operations, and
                customer-focused decisions mattered.
              </p>
            </div>

            <div>
              <h3 class="text-2xl font-bold text-[#3a1a22]">
                Real Estate
              </h3>

              <p class="mt-3 text-base leading-7 text-[#7a6167]">
                Returned home to partner with family and help people move into
                and within our community as a Real Estate Broker.
              </p>
            </div>
          </div>
        </section>

        <section class="mt-10 rounded-3xl bg-white p-8 shadow-sm ring-1 ring-[#efe4e7] md:p-10">
          <div class="text-sm font-bold uppercase tracking-[0.25em] text-[#651024]">
            Leadership & Problem Solving
          </div>

          <h2 class="mt-3 text-4xl font-bold tracking-tight text-[#3a1a22]">
            Experience that translates to City Hall.
          </h2>

          <div class="mt-8 max-w-4xl space-y-6 text-lg leading-8 text-[#7a6167]">
            <p>
              Prior to returning home to Peterborough to raise my family, I
              co-founded and served as a director of a consulting firm
              specializing in business intelligence, data analytics, and
              organizational change.
            </p>

            <p>
              Organizations brought my team and me in when they wanted to
              understand a problem, improve performance, and make better
              decisions using the information available to them.
            </p>

            <p>
              My work involved projects across healthcare, grants management,
              supply chain compliance, retail logistics, and private industry.
              It required bringing together people with different perspectives,
              understanding complex issues, managing budgets, and focusing on
              practical solutions that delivered measurable results.
            </p>

<p>
  I believe those same skills are valuable at City Hall. Good
  decisions start with listening carefully, understanding how the
  system actually works, asking the right questions, and being clear
  about the outcome we're trying to achieve. They also require
  understanding incentives, weighing trade-offs, and using the best
  information available to determine whether a decision is actually
  producing the results we expected.
</p>

            <p>
              Since returning to Peterborough, I've built my career locally,
              raised my family here, and become deeply involved in the
              community. I believe that combination of professional experience,
              local knowledge, and genuine investment in Peterborough's future
              puts me in a strong position to represent residents and help guide
              the city in the right direction.
            </p>
          </div>
        </section>

        <section class="mt-10 rounded-3xl bg-white p-8 shadow-sm ring-1 ring-[#efe4e7] md:p-10">
          <div class="text-sm font-bold uppercase tracking-[0.25em] text-[#651024]">
            Community Involvement
          </div>

          <div class="mt-6 grid gap-10 md:grid-cols-[1.1fr_0.9fr] md:items-start">
            <div>
              <h2 class="text-4xl font-bold tracking-tight text-[#3a1a22]">
                Supporting organizations and activities that strengthen our
                community.
              </h2>

              <div class="mt-8 flex flex-wrap gap-3">
                {communityItems.map((item) => (
                  <div class="rounded-full bg-[#f8f1f3] px-5 py-3 text-sm font-semibold text-[#651024] ring-1 ring-[#efe4e7]">
                    {item}
                  </div>
                ))}
              </div>
            </div>

            <div>
              <img
                src="/images/pagans-family.jpg"
                alt="AJ Shearer community involvement"
                class="w-full rounded-[2rem] shadow-md ring-1 ring-[#efe4e7]"
              />
            </div>
          </div>
        </section>
      </main>

      <footer class="bg-[#651024] py-16 text-white">
        <div class="mx-auto max-w-6xl px-6">
          <div class="grid gap-10 md:grid-cols-2 md:items-center">
            <div>
              <div class="text-sm font-bold uppercase tracking-[0.25em] text-[#f3dfe5]">
                AJ Shearer
              </div>

              <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">
                Let's build a stronger Peterborough together.
              </h2>

              <p class="mt-4 max-w-2xl text-lg leading-8 text-[#f3dfe5]">
                If you'd like to learn more, volunteer, request a lawn sign, or
                simply share your thoughts, I'd love to hear from you.
              </p>
            </div>

            <div class="flex flex-wrap gap-4 md:justify-end">
              <a
                href="/"
                class="rounded-full bg-white px-6 py-3 font-semibold text-[#651024] shadow-lg transition hover:-translate-y-0.5"
              >
                Main Website
              </a>

              <a
                href="https://www.facebook.com/VoteAJShearer"
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-white/40 px-6 py-3 font-semibold text-white transition hover:bg-white/10"
              >
                Facebook
              </a>
            </div>
          </div>

          <div class="mt-12 border-t border-white/15 pt-6 text-sm text-[#f3dfe5]">
            © {new Date().getFullYear()} AJ Shearer • Candidate for Councillor,
            Monaghan Ward • City of Peterborough
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>