---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DataHeader from "../../components/data/DataHeader.astro";
import OutcomeExplorer from "../../components/data/OutcomeExplorer.jsx";
import outcomeData from "../../data/outcomes.json";
import serviceRequirements from "../../data/service-net-requirements.json";
---
<BaseLayout
  title="Peterborough Outcomes & KPIs | AJ Shearer"
  description="Connect Peterborough municipal spending context to sourced service outcomes and level-of-service indicators without confusing spending with results."
  canonical="https://vote.ajshearer.com/data/outcomes"
>
  <div class="min-h-screen bg-[#f8f1f3] text-[#3a1a22]">
    <DataHeader />
    <section class="border-b border-[#eadde1] bg-white">
      <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
        <a href="/data" class="text-sm font-bold text-[#651024]">← Peterborough By The Numbers</a>
        <div class="mt-6 max-w-4xl">
          <div class="text-xs font-black uppercase tracking-[0.24em] text-[#651024]">Outcomes & KPIs</div>
          <h1 class="mt-3 text-4xl font-black tracking-tight md:text-6xl">What are we getting for it?</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-[#7a6167]">Budgets tell us what City Hall puts into a system. These measures show how key outcomes are moving over time: housing progress, transit use, crime severity, infrastructure condition and pressure in the housing system. Where the City only publishes activities rather than a comparable outcome trend, that limitation is shown explicitly.</p>
        </div>
        <div class="mt-7 rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm leading-6 text-amber-950">
          <strong>Read this carefully:</strong> a budget trend beside an outcome does not prove one caused the other. Some outcomes are affected by the economy, senior governments, private investment and community organizations; some Social Services metrics cover both the City and County. The scope and source are shown so those limitations stay visible.
        </div>
      </div>
    </section>
    <main class="mx-auto max-w-6xl px-6 py-12 md:py-16">
      <OutcomeExplorer client:load outcomeData={outcomeData} serviceRequirements={serviceRequirements} />
    </main>
  </div>
</BaseLayout>
