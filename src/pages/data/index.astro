---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DataHeader from "../../components/data/DataHeader.astro";
import overview from "../../data/budget-overview.json";
import services from "../../data/service-net-requirements.json";
import outcomeData from "../../data/outcomes.json";
import metadata from "../../data/metadata.json";

const byYear = Object.fromEntries(overview.map((row) => [row.fiscal_year, row]));
const tax2022 = byYear[2022].taxation_revenue_cad;
const tax2026 = byYear[2026].taxation_revenue_cad;
const taxChangePct = ((tax2026 - tax2022) / tax2022) * 100;

const serviceValue = (id, year) => services.find((row) => row.service_id === id && row.fiscal_year === year)?.amount_cad;
const police2022 = serviceValue("police", 2022);
const police2026 = serviceValue("police", 2026);
const policePct = ((police2026 - police2022) / police2022) * 100;

const latestMetric = (domain, metricId, period = "2025") => outcomeData.metrics.find((m) => m.domain_id === domain && m.metric_id === metricId && m.period === period);
const housing = latestMetric("housing_growth", "housing_progress");
const homelessness = latestMetric("homelessness_outcomes", "people_experienced_homelessness");
const csi = latestMetric("police_outcomes", "cma_crime_severity_index");
const transit = latestMetric("transit_outcomes", "transit_ridership");
---
<BaseLayout
  title="Peterborough By The Numbers | AJ Shearer"
  description="Understand Peterborough taxes, spending, outcomes and major Council decisions in five minutes, then dig into the full source-linked data."
  canonical="https://vote.ajshearer.com/data"
>
  <div class="min-h-screen bg-[#f8f1f3] text-[#3a1a22]">
    <DataHeader />

    <section class="overflow-hidden bg-[#651024] text-white">
      <div class="mx-auto max-w-6xl px-6 py-14 md:py-20">
        <div class="max-w-4xl">
          <div class="text-xs font-black uppercase tracking-[0.28em] text-[#f0cbd5]">Peterborough · Taxes · Results · Council</div>
          <h1 class="mt-4 text-5xl font-black leading-[0.95] tracking-tight md:text-7xl">Understand City Hall in five minutes.</h1>
          <p class="mt-6 max-w-3xl text-xl leading-8 text-white/85">Start with the questions residents actually ask. Get the short answer first, then open the full data, voting records and official sources if you want to go deeper.</p>
        </div>
        <div class="mt-9 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <a href="/data/taxes" class="rounded-2xl bg-white p-5 text-[#3a1a22] transition hover:-translate-y-0.5">
            <div class="text-xs font-black uppercase tracking-[0.18em] text-[#651024]">Taxes</div>
            <div class="mt-2 text-xl font-black">Why are taxes going up?</div>
            <div class="mt-4 text-sm font-bold text-[#651024]">Get the short answer →</div>
          </a>
          <a href="/data/spending" class="rounded-2xl bg-white p-5 text-[#3a1a22] transition hover:-translate-y-0.5">
            <div class="text-xs font-black uppercase tracking-[0.18em] text-[#651024]">Spending</div>
            <div class="mt-2 text-xl font-black">Where is the money going?</div>
            <div class="mt-4 text-sm font-bold text-[#651024]">See the biggest changes →</div>
          </a>
          <a href="/data/results" class="rounded-2xl bg-white p-5 text-[#3a1a22] transition hover:-translate-y-0.5">
            <div class="text-xs font-black uppercase tracking-[0.18em] text-[#651024]">Results</div>
            <div class="mt-2 text-xl font-black">What are we getting for it?</div>
            <div class="mt-4 text-sm font-bold text-[#651024]">See current outcomes →</div>
          </a>
          <a href="/data/decisions" class="rounded-2xl bg-white p-5 text-[#3a1a22] transition hover:-translate-y-0.5">
            <div class="text-xs font-black uppercase tracking-[0.18em] text-[#651024]">Council</div>
            <div class="mt-2 text-xl font-black">What decisions mattered?</div>
            <div class="mt-4 text-sm font-bold text-[#651024]">See major votes →</div>
          </a>
        </div>
      </div>
    </section>

    <main class="mx-auto max-w-6xl px-6 py-12 md:py-16">
      <section>
        <div class="max-w-3xl">
          <div class="text-xs font-black uppercase tracking-[0.22em] text-[#651024]">Six things worth knowing</div>
          <h2 class="mt-2 text-3xl font-black tracking-tight md:text-4xl">The quick read.</h2>
          <p class="mt-3 text-lg leading-7 text-[#7a6167]">These are starting points, not conclusions. Each one links to the explanation and the underlying data.</p>
        </div>

        <div class="mt-7 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          <a href="/data/taxes" class="rounded-3xl bg-white p-6 ring-1 ring-[#eadde1] transition hover:-translate-y-0.5 hover:shadow-md">
            <div class="text-3xl font-black text-[#651024]">+{taxChangePct.toFixed(1)}%</div>
            <div class="mt-2 text-lg font-black">City-wide tax requirement</div>
            <p class="mt-2 text-sm leading-6 text-[#7a6167]">The taxation requirement rose from about $147.4M in 2022 to $198.4M in 2026.</p>
          </a>
          <a href="/data/spending" class="rounded-3xl bg-white p-6 ring-1 ring-[#eadde1] transition hover:-translate-y-0.5 hover:shadow-md">
            <div class="text-3xl font-black text-[#651024]">+{policePct.toFixed(1)}%</div>
            <div class="mt-2 text-lg font-black">Police service trend</div>
            <p class="mt-2 text-sm leading-6 text-[#7a6167]">This uses the City’s Net Requirement Before Indirect Revenues measure. The spending page separately shows the 2026 bridge to Net Tax Levy.</p>
          </a>
          <a href="/data/taxes#legacy" class="rounded-3xl bg-white p-6 ring-1 ring-[#eadde1] transition hover:-translate-y-0.5 hover:shadow-md">
            <div class="text-3xl font-black text-[#651024]">$3.0M</div>
            <div class="mt-2 text-lg font-black">One-time 2026 Legacy offset</div>
            <p class="mt-2 text-sm leading-6 text-[#7a6167]">Accumulated Legacy Fund investment income lowered the 2026 levy, but did not permanently remove the underlying pressure.</p>
          </a>
          <a href="/data/results" class="rounded-3xl bg-white p-6 ring-1 ring-[#eadde1] transition hover:-translate-y-0.5 hover:shadow-md">
            <div class="text-3xl font-black text-[#651024]">{housing?.value_display}</div>
            <div class="mt-2 text-lg font-black">Homes in 2025</div>
            <p class="mt-2 text-sm leading-6 text-[#7a6167]">Peterborough reached 116% of its provincial housing target for the year.</p>
          </a>
          <a href="/data/results" class="rounded-3xl bg-white p-6 ring-1 ring-[#eadde1] transition hover:-translate-y-0.5 hover:shadow-md">
            <div class="text-3xl font-black text-[#651024]">{homelessness?.value_display}</div>
            <div class="mt-2 text-lg font-black">People experienced homelessness</div>
            <p class="mt-2 text-sm leading-6 text-[#7a6167]">The City's 2025 count was 16% higher than 2024.</p>
          </a>
          <a href="/data/results" class="rounded-3xl bg-white p-6 ring-1 ring-[#eadde1] transition hover:-translate-y-0.5 hover:shadow-md">
            <div class="flex items-end justify-between gap-3">
              <div class="text-3xl font-black text-[#651024]">CSI {csi?.value_display}</div>
              <div class="text-sm font-black text-emerald-700">↓ 6% YoY</div>
            </div>
            <div class="mt-2 text-lg font-black">Crime severity fell in 2025</div>
            <p class="mt-2 text-sm leading-6 text-[#7a6167]">At the same time, the regional crime rate rose slightly — a useful reminder that volume and severity are different measures.</p>
          </a>
        </div>
      </section>

      <section class="mt-14 rounded-[2rem] bg-[#3a1a22] p-7 text-white md:p-10">
        <div class="grid gap-8 lg:grid-cols-[1fr_.8fr] lg:items-center">
          <div>
            <div class="text-xs font-black uppercase tracking-[0.22em] text-[#f0cbd5]">The point</div>
            <h2 class="mt-2 text-3xl font-black tracking-tight md:text-4xl">Answer first. Evidence underneath.</h2>
            <p class="mt-4 max-w-2xl leading-7 text-white/75">The short pages are designed for residents who want a clear explanation. Every claim still leads back to the same normalized datasets, recorded votes and official-source links used by the advanced tools.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
            <a href="/data/taxes" class="rounded-2xl bg-white/10 px-5 py-4 font-bold hover:bg-white/15">Why are taxes going up? →</a>
            <a href="/data/decisions" class="rounded-2xl bg-white/10 px-5 py-4 font-bold hover:bg-white/15">Which Council decisions mattered? →</a>
          </div>
        </div>
      </section>

      <section id="advanced-tools" class="mt-14 scroll-mt-24">
        <div class="max-w-3xl">
          <div class="text-xs font-black uppercase tracking-[0.22em] text-[#651024]">Want to dig deeper?</div>
          <h2 class="mt-2 text-3xl font-black tracking-tight md:text-4xl">Open the full data tools.</h2>
          <p class="mt-3 leading-7 text-[#7a6167]">Nothing has been removed. These are the detailed explorers with filters, source links, normalization notes and the full voting archive.</p>
        </div>
        <div class="mt-7 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          <a href="/data/budget" class="rounded-2xl bg-white p-5 ring-1 ring-[#eadde1] hover:shadow-md"><div class="font-black">Budget Explorer</div><p class="mt-2 text-sm leading-6 text-[#7a6167]">22 normalized service/component series and source-reported totals.</p><div class="mt-4 text-sm font-bold text-[#651024]">Open full tool →</div></a>
          <a href="/data/tax-drivers" class="rounded-2xl bg-white p-5 ring-1 ring-[#eadde1] hover:shadow-md"><div class="font-black">Tax Driver Analysis</div><p class="mt-2 text-sm leading-6 text-[#7a6167]">Detailed 2026 levy factors, offsets and Legacy Fund history.</p><div class="mt-4 text-sm font-bold text-[#651024]">Open full tool →</div></a>
          <a href="/data/votes" class="rounded-2xl bg-white p-5 ring-1 ring-[#eadde1] hover:shadow-md"><div class="font-black">Vote Explorer</div><p class="mt-2 text-sm leading-6 text-[#7a6167]">{metadata.verifiedMotionCount} source-linked significant motions plus Strong Mayor Powers.</p><div class="mt-4 text-sm font-bold text-[#651024]">Search the archive →</div></a>
          <a href="/data/outcomes" class="rounded-2xl bg-white p-5 ring-1 ring-[#eadde1] hover:shadow-md"><div class="font-black">Outcomes & KPIs</div><p class="mt-2 text-sm leading-6 text-[#7a6167]">Fresh signals first, with older context and data-quality notes available.</p><div class="mt-4 text-sm font-bold text-[#651024]">Open full tool →</div></a>
        </div>
        <details class="mt-7 rounded-2xl border border-[#e2d1d6] bg-[#fffafb] p-5">
          <summary class="cursor-pointer font-bold text-[#651024]">About the data and methodology</summary>
          <div class="mt-4 grid gap-4 text-sm leading-6 text-[#7a6167] md:grid-cols-2">
            <p><strong class="text-[#3a1a22]">Source it.</strong> Public claims trace to official City documents, minutes, police reporting, Statistics Canada or other primary-government sources.</p>
            <p><strong class="text-[#3a1a22]">Label it.</strong> Draft, approved, adopted and actual figures are kept distinct; reorganizations and stale outcome measures are called out rather than hidden.</p>
          </div>
          <a href="/data/methodology" class="mt-4 inline-flex text-sm font-bold text-[#651024] underline decoration-[#c9aab3] underline-offset-2">Read methodology, source notes and correction log →</a>
        </details>
      </section>
    </main>
  </div>
</BaseLayout>
