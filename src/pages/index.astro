        </div>
      </div>
    </section>

    <!-- THANK YOU -->
    <section class="px-5 py-10 md:py-20">
      <div class="mx-auto max-w-6xl">
        <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-[#efe4e7] md:p-10">
          <div class="text-sm font-bold uppercase tracking-[0.25em] text-[#651024]">
            Thank You
          </div>

          <h2 class="mt-3 text-[clamp(2.75rem,8vw,4rem)] font-bold leading-[1.02] tracking-tight text-[#3a1a22] md:text-5xl">
            Thanks for taking the time to learn more about me and the campaign.
          </h2>

          <p class="mt-5 text-[1.3rem] leading-9 text-[#7a6167]">
            Peterborough is an incredible place to raise a family, build a
            career, and put down roots. I'm running because I believe we can
            make smarter, more practical decisions that keep our city
            affordable, improve safety, strengthen our economy, and produce
            better results from the resources we already have.
          </p>

          <p class="mt-5 text-[1.3rem] leading-9 text-[#7a6167]">
            If you're looking for additional information, have questions about
            the campaign, or simply want to connect, please don't hesitate to
            reach out.
          </p>
        </div>
      </div>
    </section>

    <!-- VOTING INFORMATION -->
    <section id="vote" class="bg-[#f8f1f3] px-5 py-10 md:py-20">
      <div class="mx-auto max-w-6xl">
        <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-[#efe4e7] md:p-10">
          <div class="text-sm font-bold uppercase tracking-[0.25em] text-[#651024]">
            Election Information
          </div>

          <h2 class="mt-3 text-[clamp(2.75rem,8vw,4rem)] font-bold leading-[1.02] tracking-tight text-[#3a1a22] md:text-5xl">
            How and Where to Vote
          </h2>

          <p class="mt-5 text-[1.3rem] leading-9 text-[#7a6167]">
            Peterborough's 2026 Municipal and School Board Election takes place
            on <strong>Monday, October 26, 2026</strong>. Residents can vote
            online, vote early in person, or cast a ballot at their ward's
            Election Day voting location.
          </p>

          <div class="mt-8 grid gap-6 lg:grid-cols-3">

            <!-- REGISTRATION -->
            <div class="flex flex-col rounded-2xl bg-[#f8f1f3] p-6">
              <h3 class="text-2xl font-bold text-[#651024]">
                Check Your Registration
              </h3>

              <p class="mt-3 flex-grow text-lg leading-8 text-[#7a6167]">
                The City's online voter services are now available. You can
                confirm that you're on the voters' list, add or update your
                information, view your voting location, and see the candidates
                who will appear on your ballot.
              </p>

              <a
                href="https://www.peterborough.ca/council-city-hall/elections/voters/"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-flex w-fit rounded-full bg-[#651024] px-5 py-3 font-semibold text-white transition hover:bg-[#7a2337]"
              >
                Check Your Voter Information
              </a>
            </div>

            <!-- ONLINE / ADVANCE -->
            <div class="rounded-2xl bg-[#f8f1f3] p-6">
              <h3 class="text-2xl font-bold text-[#651024]">
                Vote Online or Vote Early
              </h3>

              <p class="mt-3 text-lg leading-8 text-[#7a6167]">
                <strong>Online voting opens Monday, October 5 at 10 a.m.</strong>
                and remains available until
                <strong>8 p.m. on Election Day, October 26.</strong>
              </p>

              <div class="mt-5 border-t border-[#d9b8c2] pt-5">
                <div class="font-bold text-[#3a1a22]">
                  Advance In-Person Voting
                </div>

                <p class="mt-2 text-lg leading-8 text-[#7a6167]">
                  <strong>Wednesday, October 14</strong><br />
                  10 a.m. to 8 p.m.<br />
                  Healthy Planet Arena<br />
                  911 Monaghan Rd.
                </p>
