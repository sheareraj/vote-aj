---
import BaseLayout from "../layouts/BaseLayout.astro";

const priorities = [
  {
    title: "Affordability & Responsible Government",
    body: `Keeping future tax increases as low as reasonably possible by controlling the growth of municipal costs, planning infrastructure for the long term, measuring the value taxpayers receive, and growing Peterborough's commercial and industrial tax base.`,
    link: "/priorities#affordability",
  },
  {
    title: "Economic Growth & Employment Lands",
    body: `Expanding Peterborough's economic base by supporting investment, creating better conditions for job growth, and working collaboratively with Cavan Monaghan and the Province to move employment lands forward.`,
    link: "/priorities#prosperity",
  },
  {
    title: "Safer Streets & Better Outcomes",
    body: `Taking a practical approach to homelessness and public safety by measuring whether services are producing better outcomes, supporting evidence-based policing, and protecting residents, businesses, and public spaces.`,
    link: "/priorities",
  },
];

const decisionPrinciples = [
  {
    title: "Understand the System",
    body: `Look beyond individual symptoms and understand how decisions in one part of the City affect everything around them.`,
  },
  {
    title: "Measure Outcomes",
    body: `Judge programs and spending by the results they produce, not simply by how much money is spent or how much activity takes place.`,
  },
  {
    title: "Understand Incentives",
    body: `Policies influence behaviour. Good decisions require understanding the incentives we are creating for residents, businesses, organizations, and government.`,
  },
  {
    title: "Explain the Trade-offs",
    body: `There are rarely cost-free solutions. Council should be clear about what residents are gaining, what they are giving up, and why a decision makes sense.`,
  },
];

const YOUTUBE_API_KEY = import.meta.env.YOUTUBE_API_KEY;
const PLAYLIST_ID = "PLfzsxh8e8t4A";

let latestVideoId = "";
let latestVideoTitle = "Latest Episode";
let latestVideoUrl =
  "https://www.youtube.com/playlist?list=PLfzsxh8e8t4A";

if (YOUTUBE_API_KEY) {
  try {
    const response = await fetch(
      `https://www.googleapis.com/youtube/v3/playlistItems?part=snippet,contentDetails&playlistId=${PLAYLIST_ID}&maxResults=50&key=${YOUTUBE_API_KEY}`
    );

    if (response.ok) {
      const data = await response.json();

      const videos = (data.items ?? [])
        .filter(
          (item) =>
            item?.contentDetails?.videoId &&
            item?.snippet?.title &&
            item.snippet.title !== "Private video" &&
            item.snippet.title !== "Deleted video"
        )
        .sort((a, b) => {
          const dateA = new Date(
            a.contentDetails?.videoPublishedAt ||
              a.snippet?.publishedAt ||
              0
          ).getTime();

          const dateB = new Date(
            b.contentDetails?.videoPublishedAt ||
              b.snippet?.publishedAt ||
              0
          ).getTime();

          return dateB - dateA;
        });

      const latestVideo = videos[0];

      if (latestVideo) {
        latestVideoId = latestVideo.contentDetails.videoId;
        latestVideoTitle = latestVideo.snippet.title;
        latestVideoUrl = `https://www.youtube.com/watch?v=${latestVideoId}`;
      }
    } else {
      console.error(
        "YouTube API error:",
        response.status,
        await response.text()
      );
    }
  } catch (error) {
    console.error("Unable to load latest YouTube episode:", error);
  }
}
