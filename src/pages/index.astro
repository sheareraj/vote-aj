---
import BaseLayout from "../layouts/BaseLayout.astro";

const priorities = [
  {
    title: "Affordability & Responsible Government",
    body: `Keep pressure on household tax bills by watching how quickly City costs grow, planning infrastructure before it becomes an emergency, and asking whether taxpayers are getting good value for what they spend.`,
    link: "/priorities#affordability",
  },
  {
    title: "Economic Growth & Employment Lands",
    body: `Grow the local job and business base so more of the City's costs are shared beyond homeowners. That means making investment easier and working to make more land ready for employers and job-creating businesses.`,
    link: "/priorities#prosperity",
  },
  {
    title: "Safer Streets & Better Outcomes",
    body: `Focus on whether our public-safety and homelessness responses are actually making streets, neighbourhoods, businesses, and public spaces safer - not just on how much activity or spending is taking place.`,
    link: "/priorities",
  },
];

const decisionPrinciples = [
  "What problem are we actually trying to solve?",
  "Will this make things better - and how will we know?",
  "What behaviour will this decision encourage?",
  "What will it cost, and what are we giving up?",
];

const DTC_CHANNEL_URL = "https://www.youtube.com/@ajshearer2307";
const ELEVATOR_PITCH_EMBED_URL = "https://www.youtube.com/embed/Z4292sga-Vw";
---

<BaseLayout title="AJ Shearer for Monaghan Ward Councillor">
  <div class="bg-[#f8f1f3] text-[#3a1a22]">

    <!-- HEADER -->
    <header class="sticky top-0 z-30 border-b border-[#efe4e7] bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-4 md:px-6">
        <a href="/" class="shrink-0">
          <div class="text-xl font-bold tracking-tight text-[#651024] md:text-2xl">
            AJ Shearer
          </div>
          <div class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-[#7a6167] md:text-xs">
            Monaghan Ward
          </div>
          <div class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-[#7a6167] md:text-xs">
            Peterborough
          </div>
        </a>

        <nav class="hidden gap-6 text-sm font-medium text-[#7a6167] lg:flex">
          <a href="#priorities" class="hover:text-[#651024]">Priorities</a>
          <a href="#about" class="hover:text-[#651024]">About</a>
          <a href="#diary" class="hover:text-[#651024]">Diary</a>
          <a href="/data" class="hover:text-[#651024]">Data</a>
          <a href="#vote" class="hover:text-[#651024]">How To Vote</a>
          <a href="#involved" class="hover:text-[#651024]">Get Involved</a>
        </nav>

        <div class="hidden gap-3 lg:flex">
          <a
            href="#involved"
            class="rounded-full bg-[#651024] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#7a2337]"
          >
            Get in touch
          </a>
          <a
            href="#involved"
            class="rounded-full bg-[#651024] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#7a2337]"
          >
            Order a Sign
          </a>
          <a
            href="/donate"
            class="rounded-full bg-[#2b0b14] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#3f1320]"
          >
            Donate
          </a>
        </div>

        <div class="flex gap-2 lg:hidden">
          <a
            href="#vote"
            class="rounded-full bg-[#651024] px-4 py-2.5 text-sm font-semibold text-white"
          >
            Vote
          </a>
          <a
            href="#involved"
            class="rounded-full bg-[#651024] px-4 py-2.5 text-sm font-semibold text-white"
          >
            Contact
          </a>
          <a
            href="/donate"
            class="rounded-full bg-[#2b0b14] px-4 py-2.5 text-sm font-semibold text-white"
          >
            Donate
          </a>
        </div>
      </div>
    </header>

    <!-- HERO -->
    <section class="bg-[#651024] text-white lg:relative lg:min-h-[78vh] lg:overflow-hidden">
      <div class="lg:hidden">
        <img
          src="/images/hero-main.jpg"
          alt="AJ Shearer in Peterborough"
          class="h-auto w-full"
        />

        <div class="px-5 py-7">
          <div class="mb-4 inline-flex rounded-full border border-white/25 bg-white/10 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-white/90">
            Running for City Council
          </div>

          <h1 class="text-[clamp(3.25rem,10vw,4.75rem)] font-black leading-[0.9] tracking-tight">
            A practical voice for Monaghan Ward.
          </h1>

          <p class="mt-4 text-lg font-semibold tracking-wide text-white">
            Attentive representation. Clear answers. Follow-through.
          </p>

          <p class="mt-4 text-[1.25rem] leading-8 text-white/90">
            Council decisions affect everyday life. My goal is to give Monaghan
            Ward attentive, responsive representation: listen carefully, do the
            homework, explain the trade-offs, and follow through.
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href="#priorities"
              class="rounded-full bg-white px-5 py-3 font-semibold text-[#651024]"
            >
              My Priorities
            </a>
            <a
              href="#involved"
              class="rounded-full border border-white/40 px-5 py-3 font-semibold text-white"
            >
              Get Involved
            </a>
            <a
              href="/donate"
              class="rounded-full bg-[#2b0b14] px-5 py-3 font-semibold text-white"
            >
              Donate
            </a>
          </div>
        </div>
      </div>

      <div class="hidden lg:block">
        <img
          src="/images/hero-main.jpg"
          alt="AJ Shearer in Peterborough"
          class="absolute inset-0 h-full w-full object-cover object-[85%_center]"
        />

        <div class="absolute inset-0 bg-gradient-to-r from-[#651024]/95 via-[#651024]/35 via-30% to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-transparent to-black/20"></div>

        <div class="relative z-10 mx-auto flex min-h-[78vh] max-w-6xl items-center px-6 py-16">
          <div class="max-w-2xl">
            <div class="mb-4 inline-flex rounded-full border border-white/25 bg-white/10 px-4 py-1 text-xs font-semibold uppercase tracking-[0.25em] text-white/90 backdrop-blur">
              Running for City Council
            </div>

            <h1 class="text-5xl font-black leading-none tracking-tight xl:text-7xl">
              A practical voice for Monaghan Ward.
            </h1>

            <p class="mt-4 text-xl font-semibold tracking-wide text-white">
              Attentive representation. Clear answers. Follow-through.
            </p>

            <p class="mt-4 max-w-xl text-xl leading-8 text-white/90">
              Council decisions affect everyday life. My goal is to give Monaghan
              Ward attentive, responsive representation: listen carefully, do the
              homework, explain the trade-offs, and follow through.
            </p>

            <div class="mt-8 flex flex-wrap gap-4">
              <a
                href="#priorities"
                class="rounded-full bg-white px-6 py-3 font-semibold text-[#651024] shadow-lg"
              >
                My Priorities
              </a>
              <a
                href="#involved"
                class="rounded-full border border-white/40 px-6 py-3 font-semibold text-white hover:bg-white/10"
              >
                Get Involved
              </a>
              <a
                href="/donate"
                class="rounded-full bg-[#2b0b14] px-6 py-3 font-semibold text-white shadow-lg hover:bg-[#3f1320]"
              >
                Donate
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CORE PRIORITIES -->
    <section id="priorities" class="border-b border-[#e6dadd] bg-white px-5 py-10 md:py-14">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-5 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
          <div>
            <div class="text-sm font-bold uppercase tracking-[0.25em] text-[#651024]">
              Priorities for Monaghan Ward
            </div>
            <h2 class="mt-2 text-[clamp(2.5rem,7vw,3.6rem)] font-bold leading-[1.02] tracking-tight text-[#3a1a22]">
              Pay attention to the things that affect daily life.
            </h2>
          </div>

          <p class="text-[1.12rem] leading-8 text-[#7a6167]">
            Residents should be able to see what their councillor is working on,
            why it matters, and what progress is being made. These are the areas
            where I intend to put most of my attention.
          </p>
        </div>

        <div class="mt-8 border-y border-[#e6dadd] lg:grid lg:grid-cols-3 lg:divide-x lg:divide-[#e6dadd]">
          {priorities.map((priority) => (
            <div class="border-b border-[#e6dadd] py-6 last:border-b-0 lg:border-b-0 lg:px-6 lg:first:pl-0 lg:last:pr-0">
              <h3 class="text-[1.55rem] font-bold leading-tight tracking-tight text-[#3a1a22]">
                {priority.title}
              </h3>

              <p class="mt-3 text-[1.03rem] leading-7 text-[#7a6167]">
                {priority.body}
              </p>

              <a
                href={priority.link}
                class="mt-4 inline-flex items-center gap-2 font-semibold text-[#651024] hover:text-[#7a2337]"
              >
                Read More <span aria-hidden="true">→</span>
              </a>
            </div>
          ))}
        </div>

        <!-- QUALITY OF LIFE -->
        <div class="mt-8 grid gap-4 border-b border-[#e6dadd] pb-8 md:grid-cols-[1fr_auto] md:items-end">
          <div>
            <div class="text-xs font-bold uppercase tracking-[0.22em] text-[#651024]">
              A City People Want to Live In
            </div>

            <h3 class="mt-1 text-2xl font-bold text-[#3a1a22]">
              Recreation, Arts & Quality of Life
            </h3>

            <p class="mt-2 max-w-4xl text-base leading-7 text-[#7a6167]">
              Good representation is also about protecting the everyday things
              that make a neighbourhood worth living in - parks, recreation, sports,
              arts, culture, and the community groups that bring people together.
            </p>
          </div>

          <a
            href="/priorities#recreation"
            class="inline-flex w-fit items-center gap-2 font-semibold text-[#651024] hover:text-[#7a2337]"
          >
            Read More <span aria-hidden="true">→</span>
          </a>
        </div>

        <!-- HOW AJ MAKES DECISIONS -->
        <div class="mt-8 bg-[#651024] px-6 py-7 text-white md:px-8 md:py-8">
          <div class="grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
            <div>
              <div class="text-xs font-bold uppercase tracking-[0.22em] text-[#f3dfe5]">
                How I'll Make Decisions
              </div>

              <h3 class="mt-2 text-2xl font-bold leading-tight text-white md:text-3xl">
                Before I vote on something, I want four questions answered.
              </h3>

              <p class="mt-3 max-w-md text-base leading-7 text-[#f3dfe5]">
                Residents should not need to decode City Hall to understand a decision.
                I want the problem, the expected result, the side effects, and the cost
                explained in plain language.
              </p>
            </div>

            <div class="grid border-y border-white/25 sm:grid-cols-2">
              {decisionPrinciples.map((principle, index) => (
                <div
                  class:list={[
                    "py-4 text-base font-semibold leading-6 text-white sm:px-5",
                    index < decisionPrinciples.length - 1
                      ? "border-b border-white/20"
                      : "",
                    index >= 2 ? "sm:border-b-0" : "",
                    index % 2 === 0
                      ? "sm:border-r sm:border-white/20"
                      : "",
                  ]}
                >
                  <span class="mr-2 text-[#e9c6cf]">{index + 1}.</span>
                  {principle}
                </div>
              ))}
            </div>
          </div>

          <a
            href="/priorities#accountability"
            class="mt-6 inline-flex items-center gap-2 font-semibold text-white underline decoration-white/40 underline-offset-4 hover:decoration-white"
          >
            Read more about my approach <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="bg-[#f8f1f3] px-5 py-10 md:py-14">
      <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-[0.8fr_1.2fr] md:items-center">
        <img
          src="/images/family-photo.jpg"
          alt="AJ Shearer and family"
          class="w-full rounded-xl shadow-sm"
        />

        <div>
          <div class="text-sm font-bold uppercase tracking-[0.25em] text-[#651024]">
            About AJ
          </div>

          <h2 class="mt-2 text-[clamp(2.35rem,6vw,3.45rem)] font-bold leading-[1.03] tracking-tight text-[#3a1a22]">
            Local roots. Practical experience. Accessible representation.
          </h2>

          <p class="mt-5 text-[1.12rem] leading-8 text-[#7a6167]">
            My family has roots in the Peterborough area spanning generations. I'm a
            husband, father, business professional, and long-time member of the
            community, and my wife Seanna and I are raising our two boys here.
            I know representation starts with being available, listening, and staying
            connected to what is happening in the ward.
          </p>

          <p class="mt-4 text-[1.12rem] leading-8 text-[#7a6167]">
            My background in engineering, business intelligence, data analytics,
            change management, and real estate gives me tools to work through complex
            issues. The point of those skills is simple: help residents get clearer
            answers, better follow-through, and decisions they can understand.
          </p>

          <a
            href="/resume"
            class="mt-5 inline-flex items-center gap-2 font-semibold text-[#651024] hover:text-[#7a2337]"
          >
            View My Experience <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- GO DEEPER: DTC + DATA -->
    <section id="explore" class="border-y border-[#e6dadd] bg-white px-5 py-10 md:py-14">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <div class="text-sm font-bold uppercase tracking-[0.25em] text-[#651024]">
            Follow the Work
          </div>

          <h2 class="mt-2 text-[clamp(2.35rem,6vw,3.45rem)] font-bold leading-[1.03] tracking-tight text-[#3a1a22]">
            See the work behind the positions - and the information behind the work.
          </h2>
        </div>

        <div class="mt-8 border-y border-[#e6dadd] lg:grid lg:grid-cols-2 lg:divide-x lg:divide-[#e6dadd]">
          <!-- DTC -->
          <article id="diary" class="border-b border-[#e6dadd] py-7 lg:border-b-0 lg:pr-10">
            <div class="aspect-video overflow-hidden rounded-xl bg-[#2b0b14]">
              <iframe
                class="h-full w-full"
                src={ELEVATOR_PITCH_EMBED_URL}
                title="AJ Shearer - Elevator Pitch"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>

            <div class="mt-5 text-xs font-bold uppercase tracking-[0.22em] text-[#651024]">
              Diary of a Transparent Candidate
            </div>

            <h3 class="mt-1 text-2xl font-bold tracking-tight text-[#3a1a22]">
              See the work before the conclusion.
            </h3>

            <p class="mt-3 text-base leading-7 text-[#7a6167]">
              I want residents to be able to see more than a finished campaign
              position. This series shows the conversations, research, and questions
              that are shaping how I approach local issues.
            </p>

            <div class="mt-4 flex flex-wrap gap-5">
              <a
                href="/dtc"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 font-semibold text-[#651024] hover:text-[#7a2337]"
              >
                View All Episodes <span aria-hidden="true">→</span>
              </a>

              <a
                href={DTC_CHANNEL_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-[#7a6167] hover:text-[#651024]"
              >
                YouTube
              </a>
            </div>
          </article>

          <!-- DATA -->
          <article id="data" class="py-7 lg:pl-10">
            <div class="text-xs font-bold uppercase tracking-[0.22em] text-[#651024]">
              My Background in Action
            </div>

            <h3 class="mt-1 text-2xl font-bold tracking-tight text-[#3a1a22]">
              Peterborough By The Numbers
            </h3>

            <p class="mt-3 text-base leading-7 text-[#7a6167]">
              Peterborough By The Numbers puts my analytical background to practical
              use: taking City information that can be difficult to navigate and
              organizing it around the questions residents are actually trying to answer.
            </p>

            <div class="mt-5 border-l-4 border-[#651024] pl-4">
              <div class="text-lg font-bold text-[#3a1a22]">
                Clear answer first. Details when you want them.
              </div>

              <p class="mt-1 text-base leading-7 text-[#7a6167]">
                You should not need to be an accountant or policy expert to follow
                City Hall. Start with a plain-language answer, then dig into the data,
                voting records, methodology, and sources if you want more detail.
              </p>
            </div>

            <div class="mt-5 divide-y divide-[#e6dadd] border-y border-[#e6dadd]">
              <a href="/data/taxes" class="flex items-center justify-between py-3 font-semibold text-[#3a1a22] hover:text-[#651024]">
                Taxes <span aria-hidden="true">→</span>
              </a>
              <a href="/data/spending" class="flex items-center justify-between py-3 font-semibold text-[#3a1a22] hover:text-[#651024]">
                Spending <span aria-hidden="true">→</span>
              </a>
              <a href="/data/outcomes" class="flex items-center justify-between py-3 font-semibold text-[#3a1a22] hover:text-[#651024]">
                Results <span aria-hidden="true">→</span>
              </a>
              <a href="/data/votes" class="flex items-center justify-between py-3 font-semibold text-[#3a1a22] hover:text-[#651024]">
                Council <span aria-hidden="true">→</span>
              </a>
            </div>

            <a
              href="/data"
              class="mt-5 inline-flex items-center gap-2 font-semibold text-[#651024] hover:text-[#7a2337]"
            >
              Explore the Data Portal <span aria-hidden="true">→</span>
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- VOTING INFORMATION -->
    <section id="vote" class="bg-[#f8f1f3] px-5 py-10 md:py-14">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-5 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div>
            <div class="text-sm font-bold uppercase tracking-[0.25em] text-[#651024]">
              Election Information
            </div>

            <h2 class="mt-2 text-[clamp(2.35rem,6vw,3.45rem)] font-bold leading-[1.03] tracking-tight text-[#3a1a22]">
              Make voting information easy to find.
            </h2>
          </div>

          <p class="text-[1.08rem] leading-8 text-[#7a6167]">
            One basic part of serving the ward is making useful information easy
            to find. Here are the main voting options for Monaghan Ward in one place.
          </p>
        </div>

        <div class="mt-7 border-y border-[#d9c9ce] md:grid md:grid-cols-3 md:divide-x md:divide-[#d9c9ce]">
          <div class="border-b border-[#d9c9ce] py-5 md:border-b-0 md:px-6 md:first:pl-0">
            <div class="text-xs font-bold uppercase tracking-[0.18em] text-[#651024]">
              Online Voting
            </div>

            <div class="mt-1 text-2xl font-bold text-[#3a1a22]">
              Oct. 5–26
            </div>

            <p class="mt-2 leading-7 text-[#7a6167]">
              Opens October 5 at 10 a.m. and remains available until 8 p.m. on Election Day.
            </p>
          </div>

          <div class="border-b border-[#d9c9ce] py-5 md:border-b-0 md:px-6">
            <div class="text-xs font-bold uppercase tracking-[0.18em] text-[#651024]">
              Advance In-Person
            </div>

            <div class="mt-1 text-2xl font-bold text-[#3a1a22]">
              Oct. 14
            </div>

            <p class="mt-2 leading-7 text-[#7a6167]">
              10 a.m. to 8 p.m.<br />
              Healthy Planet Arena<br />
              911 Monaghan Rd.
            </p>
          </div>

          <div class="py-5 md:px-6 md:last:pr-0">
            <div class="text-xs font-bold uppercase tracking-[0.18em] text-[#651024]">
              Election Day · Monaghan Ward
            </div>

            <div class="mt-1 text-2xl font-bold text-[#651024]">
              Oct. 26
            </div>

            <p class="mt-2 leading-7 text-[#7a6167]">
              10 a.m. to 8 p.m.<br />
              Westdale United Church<br />
              1509 Sherbrooke St.
            </p>
          </div>
        </div>

        <div class="mt-5 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <p class="max-w-2xl text-base leading-7 text-[#7a6167]">
            For registration, accessibility information, voter cards, and the most
            current election details, the City's voter services remain the official source.
          </p>

          <div class="flex flex-wrap gap-x-5 gap-y-2">
            <a
              href="https://www.peterborough.ca/council-city-hall/elections/voters/"
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-[#651024] hover:text-[#7a2337]"
            >
              Check Your Voter Information →
            </a>

            <a
              href="https://www.peterborough.ca/council-city-hall/elections/voters/"
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-[#7a6167] hover:text-[#651024]"
            >
              Official Voting Information
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- GET INVOLVED -->
    <section
      id="involved"
      class="bg-gradient-to-br from-[#7a2337] to-[#651024] px-5 py-12 text-white md:py-14"
    >
      <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-[1fr_0.95fr] md:items-start">
        <div>
          <div class="text-sm font-bold uppercase tracking-[0.25em] text-[#f3dfe5]">
            Get involved
          </div>

          <h2 class="mt-3 text-[2.6rem] font-bold leading-[1.05] tracking-tight md:text-4xl">
            Have a question, concern, or idea for the ward?
          </h2>

          <p class="mt-5 text-xl leading-8 text-[#f3dfe5]">
            Get in touch directly. I want residents to have an easy way to ask a
            question, raise a local issue, request a lawn sign, or find out how to get involved.
          </p>

          <div class="mt-8">
            <a
              href="/donate"
              class="rounded-lg bg-[#2b0b14] px-5 py-3 text-center font-semibold text-white"
            >
              Donate to Support the Campaign
            </a>
          </div>
        </div>

        <div class="rounded-xl bg-white p-6 text-[#3a1a22] shadow-sm">
          <div class="text-[1.8rem] font-bold tracking-tight">
            Get in touch
          </div>

          <div class="mt-1 text-lg text-[#7a6167]">
            Send me a note and tell me what is happening in your neighbourhood.
          </div>

          <form
            action="https://formspree.io/f/mzdojrpy"
            method="POST"
            class="mt-6 grid gap-4"
          >
            <input
              name="name"
