                  href="https://www.youtube.com/playlist?list=PLfzsxh8e8t4A"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-full bg-[#651024] px-6 py-3 font-semibold text-white transition hover:bg-[#7a2337]"
                >
                  View All Episodes
                </a>

                <a
